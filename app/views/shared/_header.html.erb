<header class="flex h-30 items-center">
  <div>
    <%= link_to '/' do %>
      <%= image_tag "logo.png", class: "h-30" %>
    <% end %>
  </div>
  
    
  <% if user_signed_in?%>
    <div class="flex items-center gap-8 ml-auto w-70 mr-4">
      <%= link_to t('header.incidents'), incidents_path, class: "border-2 p-2 rounded-xl hover:bg-gray-500 active:bg-black active:text-white" %>
      <%= link_to t('header.logout'), destroy_user_session_path, data: { turbo_method: :delete }, class: "border-2 p-2 rounded-xl hover:bg-gray-500 active:bg-black active:text-white" %>
    </div>
  <% else %>
    <div class="flex items-center gap-8 ml-auto w-50 mr-4">
      <%= link_to t('header.sign_up'), new_user_registration_path, class: "border-2 p-2 rounded-xl hover:bg-gray-500 active:bg-black active:text-white" %>
      <%= link_to t('header.login'), new_user_session_path, class: "border-2 p-2 rounded-xl hover:bg-gray-500 active:bg-black active:text-white" %>
    </div>
  <% end %>
  

</header>