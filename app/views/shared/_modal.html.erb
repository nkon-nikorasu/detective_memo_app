<div data-controller="modal"
     data-action="turbo:frame-load->modal#open"
     class="relative z-50">

  <dialog data-modal-target="dialog"
          class="fixed inset-0 m-auto w-[90vw] max-w-lg max-h-[90vh] overflow-y-auto rounded-xl p-6 shadow-xl backdrop:bg-black/50">

    <button type="button"
            data-action="modal#close">
      ✕
    </button>

    <%= turbo_frame_tag "modal", data: { action: "turbo:frame-load->modal#open" } %>

  </dialog>
</div>