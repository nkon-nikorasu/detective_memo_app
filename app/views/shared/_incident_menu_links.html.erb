<ul class="space-y-2">
  <li>
    <%= link_to "事件詳細",
                incident_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('incidents') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>

  <li>
    <%= link_to @incident.book.present? ? "書籍変更" : "書籍登録",
                search_incident_books_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('books') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>

  <li>
    <%= link_to "人物登録",
                incident_characters_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('characters') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>

  <li>
    <%= link_to "人物相関図",
                incident_character_relationships_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('character_relationships') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>

  <li>
    <%= link_to "時系列登録",
                incident_incident_times_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('incident_times') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>

  <li>
    <%= link_to "推理メモ",
                incident_memos_path(@incident),
                class: "flex flex-1 rounded-xl h-full py-3 mx-2 items-center justify-center box-border hover:bg-blue-400 active:text-white #{sidebar_active?('memos') ? 'bg-blue-500 font-bold text-white' : 'bg-blue-200'}" %>
  </li>
</ul>