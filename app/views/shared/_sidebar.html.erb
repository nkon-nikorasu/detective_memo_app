<details class="md:hidden w-full bg-gray-100 p-2">
  <summary class="cursor-pointer bg-blue-200 rounded-xl p-3 text-center font-bold">
    事件メニュー
  </summary>

  <div class="mt-2">
    <%= render "shared/incident_menu_links" %>
  </div>
  <% if @incident.book.present? %>
    <%= image_tag incident_book_thumbnail(@incident), class: "w-full p-5" %>
  <% end %>
</details>

<%# PC用サイドバー %>
<aside class="hidden md:flex md:w-1/6 shrink-0 bg-gray-100 my-2 flex-col">
  <h2>事件メニュー</h2>

  <%= render "shared/incident_menu_links" %>

  <% if @incident.book.present? %>
    <%= image_tag incident_book_thumbnail(@incident), class: "p-5" %>
  <% end %>
</aside>