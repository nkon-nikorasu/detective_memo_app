<% @books.first(10).each do |book| %>
  <li
    role="option"
    data-autocomplete-value="<%= book[:title] %>"
    class="px-4 py-2 cursor-pointer hover:bg-gray-100"
  >
    <%= book[:title] %>
    <span class="text-gray-500 text-sm">
      <%= book[:authors].join("、") %>
    </span>
  </li>
<% end %>