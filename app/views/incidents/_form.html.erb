<%= form_with model: @incident, id: "incident-form", class: "flex flex-col p-2 items-center" do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class="flex flex-col w-full justify-center items-center my-3">
    <%= f.label :name %>
    <%= f.text_field :name, class: "border-2 w-full h-10 px-2 rounded-xl", placeholder: "事件名を入力してください" %>
  </div>
  <div class="flex flex-col w-full justify-center items-center my-3">
    <%= f.label :tag %>
    <%= f.select :tag, Incident.tags.keys.map { |k| [t("enums.incident.tag.#{k}"), k] }, {include_blank: "指定なし"},class: "border-2 w-full h-10 px-2 rounded-xl" %>
  </div>
  <div class="flex flex-col w-full justify-center items-center my-3">
    <%= f.label :body %>
    <%= f.text_area :body, class: "border-2 w-full p-2 rounded-xl", placeholder: "説明を記述してください＊任意", rows: 10 %>
  </div>
  <%= f.submit class: "border-2 rounded-xl h-10 w-20 hover:bg-gray-500 active:bg-black active:text-white" %>
<% end %>