<% content_for(:title, t('.title')) %>
<div class="flex flex-col justify-center border-b-2 mx-2 pb-2">
  <div class="border-b-2 border-t-2 text-center bg-lime-100 p-2">
    <h2 class="text-5xl"><%= t('.title') %></h2>
  </div>
  <%= form_with model: @incident, class: "flex flex-col items-center" do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.label :book %>
      <%= f.text_field :book, class: "border-2 w-100 h-10 px-2 rounded-xl", placeholder: "書籍名を入力してください＊必須" %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.label :name %>
      <%= f.text_field :name, class: "border-2 w-100 h-10 px-2 rounded-xl", placeholder: "事件名を入力してください＊任意" %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.label :tag %>
      <%= f.select :tag, Incident.tags.keys.map { |k| [t("enums.incident.tag.#{k}"), k] }, {include_blank: "指定なし"},class: "border-2 w-100 h-10 px-2 rounded-xl", placeholder: "書籍名を入力してください＊必須" %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.label :body %>
      <%= f.text_area :body, class: "border-2 p-2 rounded-xl", placeholder: "説明を記述してください＊任意", size: "50x10" %>
    </div>
    <%= f.submit class: "border-2 rounded-xl h-10 w-20" %>
  <% end %>
</div>
<div class="flex flex-col mb-3 mx-2">
  <div class="border-b-2 flex justify-center p-2 bg-lime-100">
    <p class="text-5xl"><%= t('.incident_time') %></p>
  </div>
  <div class="mb-2">
    <%= render "incident_times/form", incident: @incident, incident_time: @incident_time %>
  </div>
  <table>
    <thead>
      <tr>
        <th><%= t('.date') %></th>
        <th><%= IncidentTime.human_attribute_name(:body) %></th>
        <th><%= IncidentTime.human_attribute_name(:position) %></th>
        <th>更新</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody id="table-time-record">
      <%= render partial: "incident_times/incident_time", collection: @incident_times, locals: { page_type: "edit" } %>
    </tbody>
  </table>
</div>
<div class="flex flex-col">
  <div class="border-b-2 border-t-2 flex justify-center p-2 mx-2 bg-lime-100">
    <p class="text-5xl"><%= t('.character') %></p>
  </div>
  <div class="mb-2">
    <%= render "characters/form", incident: @incident, character: @character %>
  </div>
  <div id="characters-table" class="flex flex-col text-center">
    <%= render partial: "characters/character", collection: @characters, locals: { page_type: "edit" } %>
  </div>
  <div class="flex justify-center">
    <%= link_to t('helpers.links.show'), incident_path(@incident), class: "flex border-2 rounded-xl h-10 w-auto items-center justify-center px-2" %>
  </div>
</div>