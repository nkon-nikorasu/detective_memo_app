<div class="border-b-2 text-center mx-2 bg-lime-100">
  <h2 class="text-5xl"><%= t('.title') %></h2>
</div>
<div class="flex flex-col gap-3 pt-2 m-2">
  <p class="text-3xl"><%= Incident.human_attribute_name(:book) %>:<%= @incident.book%></p>
  <p class="text-2xl"><%= Incident.human_attribute_name(:name) %>:<%= @incident.name%></p>
  <p class="text-2xl"><%= Incident.human_attribute_name(:tag) %>:<%= @incident.tag_i18n%></p>
  <p><%= Incident.human_attribute_name(:body) %>:</p>
  <p class="break-words"><%= @incident.body %></p>
</div>
<div class="border-b-2 text-center m-2 bg-lime-100">
  <h2 class="text-5xl"><%= t('.incident_time') %></h2>
</div>
<div class="m-2">
  <table class="w-full">
    <thead>
      <tr>
        <th>日時</th>
        <th><%= IncidentTime.human_attribute_name(:body) %></th>
      </tr>
    </thead>
    <tbody id="table-time-record">
      <%= render @incident_times %>
    </tbody>
  </table>
</div>
<div class="border-b-2 text-center m-2 bg-lime-100">
  <h2 class="text-5xl"><%= t('.character') %></h2>
</div>
<% if @characters.present? %>
  <%= render @characters %>
<% else %>
  人物記録はありません
<% end %>
<div class="flex justify-center">
  <%= link_to "事件整理画面へ", edit_incident_path(@incident), class: "flex border-2 rounded-xl h-10 w-auto items-center justify-center px-2" %>
</div>