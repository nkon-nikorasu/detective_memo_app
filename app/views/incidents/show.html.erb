<% content_for(:title, t('.title')) %>
<div class="my-2">
  <div class="border-2 text-center bg-gray-300 p-2">
    <h2 class="text-3xl md:text-5xl"><%= t('.title') %></h2>
  </div>
  <div id="flash">
    <%= render 'shared/flash' %>
  </div>
  <div class="flex flex-col gap-3 p-2">
    <% if @incident.book.present? %>
      <p class="text-3xl border-b-2"><%= Book.human_attribute_name(:title) %>:<%= @incident.book.title %></p>
      <p class="text-2xl border-b-2"><%= Book.human_attribute_name(:authors) %>:<%= incident_book_authors(@incident) %></p>
    <% else %>
      <p class="text-center">※書籍登録されていません。</p>
    <% end %>
    <div id="incident-profile" class="flex flex-col w-full">
      <%= render "incident_profile", incident: @incident  %>
    </div>
  </div>
</div>
<div class="flex justify-center mt-2">
  <%= link_to "編集", edit_incident_path(@incident), data: {turbo_frame: "modal" }, class: "flex bg-green-300 rounded-xl h-10 w-20 mx-2 items-center justify-center hover:bg-green-500 active:text-white" %>
</div>
