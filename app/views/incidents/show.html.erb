<div class="my-2">
  <div class="border-b-2 text-center bg-lime-100 p-2">
    <h2 class="text-5xl"><%= t('.title') %></h2>
  </div>
  <div class="flex flex-col gap-3 pt-2">
    <p class="text-3xl"><%= Incident.human_attribute_name(:book) %>:<%= @incident.book%></p>
    <p class="text-2xl"><%= Incident.human_attribute_name(:name) %>:<%= @incident.name%></p>
    <p class="text-2xl"><%= Incident.human_attribute_name(:tag) %>:<%= @incident.tag_i18n%></p>
    <p><%= Incident.human_attribute_name(:body) %>:</p>
    <p class="break-words"><%= @incident.body %></p>
  </div>
</div>
<div class="flex justify-center mt-2">
  <%= link_to t('helpers.links.edit'), edit_incident_path(@incident), class: "flex border-2 rounded-xl h-10 w-auto items-center justify-center px-2 hover:bg-gray-500 active:bg-black active:text-white" %>
</div>