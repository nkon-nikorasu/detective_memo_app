<div class="incident-id-<%= incident.id %> flex border h-20 mx-2 my-2">
  <div class="flex-1 flex items-center w-auto">
    <% if incident.book.present? %>
      <%= image_tag incident_book_thumbnail(incident), class: "w-12 h-16 object-contain shrink-0" %>
    <% end %>
    <p class="text-xl md:text-3xl">
      <%=  Incident.human_attribute_name(:name) %>:<%= incident.name %>
    </p>
  </div>
  <div class="flex-1 flex flex-col justify-around">
    <p><%= Incident.human_attribute_name(:tag) %>: <%=incident.tag_i18n %></p>
    <p class="font-sans"><%= t('.created_at')%>: <%=local_time(incident.created_at)%></p>
  </div>
  <div class="flex-1 flex items-center justify-around text-center">
    <%= link_to "詳細", incident_path(incident), class: "flex flex-1 bg-blue-300 rounded-xl h-full mx-2 items-center justify-center box-border hover:bg-blue-500 active:text-white" %>
    <%= link_to "編集", edit_incident_path(incident), class: "flex flex-1 bg-green-300 rounded-xl h-full mx-2 items-center justify-center hover:bg-green-500 active:text-white" %>
    <%= link_to "削除", incident_path(incident), data: {turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm')}, class: "flex flex-1 bg-red-300 rounded-xl h-full mx-2 items-center justify-center hover:bg-red-500 active:text-white" %>
  </div>
</div>