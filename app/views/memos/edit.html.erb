<% content_for(:title, t('.title')) %>
<div class="border-b-2 text-center bg-lime-100 p-2 my-2">
  <h2 class="text-5xl"><%= t('.title') %></h2>
</div>
<%= form_with model: [@incident, @memo], id: "memo-form", class: "flex flex-col items-center my-2" do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class="flex flex-col justify-center items-center my-3">
    <%= f.label :tag %>
    <%= f.select :tag, Memo.tags.keys.map { |k| [t("enums.memo.tag.#{k}"), k] }, {}, class: "border-2 w-100 h-10 px-2 rounded-xl text-center" %>
  </div>
  <div class="flex flex-col justify-center items-center my-3">
    <%= f.label :body %>
    <%= f.text_area :body, class: "border-2 p-2 rounded-xl", placeholder: "*メモを記述してください", size: "50x10" %>
  </div>
  <%= f.submit class: "border-2 rounded-xl h-10 w-20 hover:bg-gray-500 active:bg-black active:text-white" %>
<% end %>
