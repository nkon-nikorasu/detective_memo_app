<% content_for(:title, t('.title')) %>
<div class="my-2">
  <div class="border-2 flex justify-center p-2 bg-gray-300">
    <p class="text-5xl"><%= t('.title') %></p>
  </div>
  <div class="flex flex-col items-center py-2">
    <%= link_to "メモ登録",
                new_incident_memo_path(@incident),
                data: { turbo_frame: "modal" },
                class: "border-2 rounded-xl h-10 px-4 flex items-center hover:bg-gray-500 active:bg-black active:text-white" %>
  </div>
  <div class="flex flex-col items-center w-full border-b-2">
    <p class="border-b-2 w-full text-center"><%= t('.index') %></p>
    <div id="flash">
      <%= render 'shared/flash' %>
    </div>
    <div id="memo-table" class="w-full min-h-2">
      <%= render @memos %>
    </div>
  </div>
</div>
<%= render "shared/modal" %>