<div id="memo-record-<%= memo.id %>" class="border-2 rounded-xl flex flex-col h-auto w-auto p-2 my-2">
  <div class="flex justify-between items-center">
    <p class="text-3xl"><%= memo.tag_i18n %></p>
    <div class="flex gap-2">
      <%= link_to "編集", edit_incident_memo_path(memo.incident, memo), class: "bg-green-300 rounded-xl items-center justify-center p-2 hover:bg-green-500 active:text-white" %>
      <%= link_to "削除", incident_memo_path(memo.incident, memo), data: {turbo_method: :delete}, class: "bg-red-300 rounded-xl items-center justify-center p-2 hover:bg-red-500 active:text-white" %>
    </div>
  </div>
  <div>
    <p class="break-words"><%= memo.body %></p>
  </div>
</div>