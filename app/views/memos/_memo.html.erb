<div id="memo-record-<%= memo.id %>"
     class="border-2 rounded-xl flex flex-col w-auto p-2 m-2">

  <div class="flex justify-between items-center gap-2">
    <p class="text-2xl md:text-3xl min-w-0 break-words">
      <%= memo.tag_i18n %>
    </p>

    <div class="flex gap-2 shrink-0">
      <%= link_to "編集",
                  edit_incident_memo_path(memo.incident, memo),
                  data: { turbo_frame: "modal" },
                  class: "bg-green-300 rounded-xl flex items-center justify-center p-2 hover:bg-green-500 active:text-white" %>

      <%= link_to "削除",
                  incident_memo_path(memo.incident, memo),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: t('defaults.delete_confirm', item: Memo.model_name.human)
                  },
                  class: "bg-red-300 rounded-xl flex items-center justify-center p-2 hover:bg-red-500 active:text-white" %>
    </div>
  </div>

  <div class="mt-2">
    <p class="break-words whitespace-pre-wrap"><%= memo.body %></p>
  </div>
</div>