<div class="text-center divide-y divide-dashed">
  <h2 class="text-3xl"><%= t('.title') %></h2>
  <h2><%= t('.forgot_your_password') %></h2>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-2 my-2" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field flex flex-col items-center">
      <p><%= f.label :email %></p>
      <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border-2 rounded-sm" %></p>
    </div>

    <div class="actions">
      <%= f.submit t('.send_me_reset_password_instructions'), class: "border-2 p-2 mb-2 rounded-xl hover:bg-gray-500 active:bg-black active:text-white" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
