<%= form_with url: incident_character_relationships_path(@incident),
              method: :get,
              class: "flex justify-center my-3" do |f| %>

  <%= f.collection_select :character_id,
                          @characters,
                          :id,
                          :name,
                          {
                            prompt: "人物を選択してください",
                            selected: @character&.id
                          },
                          class: "p-2 border-2 rounded-xl" %>

  <%= f.submit "表示",
               class: "border-2 rounded-xl px-3 ml-2 hover:bg-gray-500" %>
<% end %>