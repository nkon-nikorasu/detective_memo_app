<%= turbo_stream.update "characters-relationship-table" do %>
  <%= render "relationships_table" %>
<% end %>

<%= turbo_stream.update "character-relationship-mermaid" do %>
  <%= render "mermaid",
             characters: @characters,
             relationships: @relationships %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>