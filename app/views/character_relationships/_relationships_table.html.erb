<% if @character.present? %>
  <p class="text-xl my-3">
    <span class="relative group inline-block cursor-help">
      <span class="underline decoration-dotted">
        <%= @character.name %>
      </span>

      <span class="absolute top-full left-1/2 -translate-x-1/2 mb-2
                   hidden group-hover:block
                   bg-white border border-gray-300 rounded-lg shadow-lg
                   p-3 w-64 z-50 text-sm text-left">

        <span class="block font-bold mb-1"><%= @character.name %></span>
        <span class="block whitespace-pre-wrap"><%= @character.body %></span>
      </span>
    </span>の人物関係
  </p>
  <table class="border-collapse border">
    <thead>
      <tr>
        <th class="border p-2"><%= CharacterRelationship.human_attribute_name(:target_character_id) %></th>
        <th class="border p-2 bg-green-100"><%= CharacterRelationship.human_attribute_name(:relation) %></th>
        <th class="border p-2 bg-blue-100">
          <%= @character.name %> → <%= CharacterRelationship.human_attribute_name(:target_character_id) %>
        </th>
        <th class="border p-2 bg-red-100">
          <%= CharacterRelationship.human_attribute_name(:target_character_id) %> → <%= @character.name %>
        </th>
        <th>更新</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody>
      <%= render @character_relationships %>
    </tbody>
  </table>
<% end %>