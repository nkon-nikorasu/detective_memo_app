<% if @character.present? %>
  <%# スマホ版 %>
  <div class="md:hidden my-3">
    <details class="text-xl text-center">
      <summary class="cursor-pointer list-none">
        <span class="underline decoration-dotted">
          <%= @character.name %>
        </span>の人物関係
      </summary>

      <div class="mt-3 mx-3 p-3 bg-white border rounded-lg shadow-md text-left text-base">
        <p class="font-bold mb-2">
          <%= @character.name %>
        </p>

        <p class="whitespace-pre-wrap break-words"><%= @character.body.presence || "未設定" %></p>
      </div>
    </details>
  </div>

  <%# PC版 %>
  <p class="hidden md:block text-xl my-3">
    <span class="relative group inline-block cursor-help">
      <span class="underline decoration-dotted">
        <%= @character.name %>
      </span>

      <span class="absolute top-full left-1/2 -translate-x-1/2 mt-2
                   hidden group-hover:block
                   bg-white border border-gray-300 rounded-lg shadow-lg
                   p-3 w-64 z-50 text-sm text-left">

        <span class="block font-bold mb-1">
          <%= @character.name %>
        </span>

        <span class="block whitespace-pre-wrap"><%= @character.body.presence || "未設定" %></span>
      </span>
    </span>の人物関係
  </p>

  <% if @character_relationships.present? %>
    <%# スマホ版 %>
    <div class="flex flex-col gap-3 md:hidden">
      <%= render partial: "character_relationship_card",
                collection: @character_relationships,
                as: :character_relationship %>
    </div>
    <%# PC版 %>
    <div class="hidden md:block">
      <table class="border-collapse border w-full">
        <thead>
          <tr>
            <th class="border p-2"><%= CharacterRelationship.human_attribute_name(:target_character_id) %></th>
            <th class="border p-2 bg-green-100"><%= CharacterRelationship.human_attribute_name(:relation) %></th>
            <th class="border p-2">
              <%= @character.name %> → <%= CharacterRelationship.human_attribute_name(:target_character_id) %>
            </th>
            <th class="border p-2">
              <%= CharacterRelationship.human_attribute_name(:target_character_id) %> → <%= @character.name %>
            </th>
            <th class="whitespace-nowrap">更新</th>
            <th class="whitespace-nowrap">削除</th>
          </tr>
        </thead>
        <tbody>
          <%= render @character_relationships %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-center p-5 text-gray-500">
      人物関係が登録されていません。
    </p>
  <% end %>
<% end %>