<tr id="character-relationship-id-<%= character_relationship.id %>" >
  <td class="border p-2">
    <% other = character_relationship.other_character(@character) %>

    <div class="relative group inline-block">
      <span class="cursor-help underline decoration-dotted">
        <%= other.name %>
      </span>

      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2
                  hidden group-hover:block
                  bg-white border border-gray-300 rounded-lg shadow-lg
                  p-3 w-64 z-50 text-sm text-left">

        <p class="font-bold mb-1"><%= other.name %></p>
        <p class="whitespace-pre-wrap"><%= other.body %></p>
      </div>
    </div>
  </td>
  <td class="border p-2 bg-green-100">
    <%= character_relationship.relation %>
  </td>
  <td class="border p-2 bg-blue-100">
    <%= character_relationship.impression_from(@character) %>
  </td>
  <td class="border p-2 bg-red-100">
    <%= character_relationship.impression_from(other) %>
  </td>
  <td class="bg-green-300 hover:bg-green-500 active:text-white"><%= link_to "更新", edit_incident_character_relationship_path(@incident, character_relationship, character_id: @character.id), data: { turbo_frame: "modal" }, class: "flex justify-center w-full" %></td>
  <td class="bg-red-300 hover:bg-red-500 active:text-white"><%= link_to "削除", incident_character_relationship_path(@incident, character_relationship), data: {turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm', item: CharacterRelationship.model_name.human)}, class: "flex justify-center w-full" %></td>
</tr>