<% content_for(:title, t('.title')) %>
<div class="flex flex-col w-full my-2">
  <div class="border-2 flex justify-center p-2 bg-gray-300">
    <p class="text-3xl md:text-5xl"><%= t('.title') %></p>
  </div>
  <div id="flash">
    <%= render 'shared/flash' %>
  </div>
  <div class="flex justify-center my-3">
    <%= link_to "人物関係登録",
                  new_incident_character_relationship_path(@incident, character_id: params[:character_id]),
                  data: { turbo_frame: "modal" },
                  class: "border-2 rounded-xl p-2 hover:bg-gray-500" %>
  </div>
  <p class="border-b-2 w-full mb-2 text-center"><%= t('.index') %></p>
  <div id="character-selector">
    <%= render "character_selector" %>
  </div>
  <div id="characters-relationship-table" class="flex flex-col text-center w-full">
    <%= render "relationships_table" %>
  </div>
  <p class="border-b-2 w-full my-2 text-center"><%= t('.mermaid') %></p>
  <div id="character-relationship-mermaid" class="w-full overflow-x-auto mt-5 border-2 rounded-3xl">
    <%= render "mermaid", characters: @characters, relationships: @relationships %>
  </div>
</div>
