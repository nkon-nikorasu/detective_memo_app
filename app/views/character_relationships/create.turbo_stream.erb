<%= turbo_stream.update "character-relationship-form-container" do %>
  <% if @character_relationship.persisted? %>
    <%= render "form",
               character_relationship: CharacterRelationship.new %>
  <% else %>
    <%= render "form",
               character_relationship: @character_relationship %>
  <% end %>
<% end %>

<% if @character_relationship.persisted? %>
  <%= turbo_stream.update "character-relationship-mermaid" do %>
    <%= render "mermaid",
               characters: @characters,
               relationships: @relationships %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>