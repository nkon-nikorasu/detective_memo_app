<%= turbo_stream.update "character-relationship-form-container" do %>
  <% if @character_relationship.persisted? %>
    <%= render "form",
               character_relationship: CharacterRelationship.new %>
  <% else %>
    <%= render "form",
               character_relationship: @character_relationship %>
  <% end %>
<% end %>

<%= turbo_stream.update "form-flash" do %>
  <%= render "shared/flash" %>
<% end %>