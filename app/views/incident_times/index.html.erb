<% content_for(:title, t('.title')) %>
<div class="flex flex-col mb-3 my-2">
  <div class="border-b-2 flex justify-center p-2 bg-lime-100">
    <p class="text-5xl"><%= t('.title') %></p>
  </div>
  <div class="flex flex-col items-center py-2">
    <%= link_to "時系列登録",
                new_incident_incident_time_path(@incident),
                data: { turbo_frame: "modal" },
                class: "border-2 rounded-xl h-10 px-4 flex items-center hover:bg-gray-500 active:bg-black active:text-white" %>
  </div>
  <p class="border-b-2 w-full text-center"><%= t('.index') %></p>
  <div id="flash">
    <%= render 'shared/flash' %>
  </div>
  <table>
    <thead>
      <tr>
        <th><%= t('.date') %></th>
        <th><%= IncidentTime.human_attribute_name(:body) %></th>
        <th><%= IncidentTime.human_attribute_name(:position) %></th>
        <th>更新</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody id="table-time-record">
      <%= render @incident_times %>
    </tbody>
  </table>
</div>
