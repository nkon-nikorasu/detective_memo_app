<div class="flex flex-col mb-3 my-2">
  <div class="border-b-2 flex justify-center p-2 bg-lime-100">
    <p class="text-5xl"><%= t('.title') %></p>
  </div>
  <div data-controller="toggle" class="flex flex-col items-center py-2">
    <button type="button" data-action="click->toggle#toggle" class="border-2 rounded-xl h-10 w-aout px-2 hover:bg-gray-500 active:bg-black active:text-white">
      <span data-toggle-target="label">登録</span>
    </button>
    <div data-toggle-target="content" class="hidden">
      <%= render "incident_times/form", incident: @incident, incident_time: @incident_time %>
    </div>
  </div>
  <p class="border-b-2 w-full mb-2 text-center"><%= t('.index') %></p>
  <table>
    <thead>
      <tr>
        <th><%= t('.date') %></th>
        <th><%= IncidentTime.human_attribute_name(:body) %></th>
        <th><%= IncidentTime.human_attribute_name(:position) %></th>
        <th>更新</th>
        <th>削除</th>
      </tr>
    </thead>
    <tbody id="table-time-record">
      <%= render @incident_times %>
    </tbody>
  </table>
</div>