<% content_for(:title, t('.title')) %>
<div class="flex flex-col mb-3 my-2">
  <div class="border-2 flex justify-center p-2 bg-gray-300">
    <p class="text-3xl md:text-5xl"><%= t('.title') %></p>
  </div>
  <div class="flex flex-col items-center py-2">
    <%= link_to "時系列登録",
                new_incident_incident_time_path(@incident),
                data: { turbo_frame: "modal" },
                class: "border-2 rounded-xl h-10 px-4 flex items-center hover:bg-gray-500 active:bg-black active:text-white" %>
  </div>
  <p class="border-b-2 w-full text-center mb-2"><%= t('.index') %></p>
  <div id="flash">
    <%= render 'shared/flash' %>
  </div>
  <div class="w-full overflow-x-auto">
    <table class="w-full min-w-[650px]">
      <thead>
        <tr>
          <th class="min-w-24"><%= IncidentTime.human_attribute_name(:position) %></th>
          <th class="min-w-32"><%= t('.date') %></th>
          <th class="min-w-48"><%= IncidentTime.human_attribute_name(:body) %></th>
          <th class="min-w-16">更新</th>
          <th class="min-w-16">削除</th>
        </tr>
      </thead>
      <tbody id="table-time-record">
        <%= render @incident_times %>
      </tbody>
    </table>
  </div>
</div>
