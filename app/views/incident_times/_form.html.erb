<div class="flex flex-col justify-center">
  <%= form_with model: [incident, incidenttime], class: "flex items-center justify-center" do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :year, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:year) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :month, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:month) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :date, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:date) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :hour, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:hour) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :second, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:minuts) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.number_field :second, class: "border-2 w-20 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:second) %>
    </div>
    <div class="flex flex-col justify-center items-center my-3">
      <%= f.text_field :body, class: "border-2 w-40 h-10 px-2 rounded-xl", placeholder: IncidentTime.human_attribute_name(:body) %>
    </div>
    <%= f.submit class: "border-2 rounded-xl h-10 w-20" %>
  <% end %>
</div>