<% if @incident_time.errors.present? %>
  <%= turbo_stream.replace "time-record-form" do %>
    <%= render 'incident_times/form', incident: @incident, incident_time: @incident_time %>
  <% end %>
<% else %>
  <%= turbo_stream.append "table-time-record" do %>
    <%= render partial: 'incident_times/incident_time', locals: { incident_time: @incident_time, page_type: "edit" } %>
  <% end %>
  <%= turbo_stream.replace "time-record-form" do %>
    <%= render 'incident_times/form', incident: @incident, incident_time: IncidentTime.new %>
  <% end %>
<% end %>