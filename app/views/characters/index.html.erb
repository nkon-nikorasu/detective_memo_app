<% content_for(:title, t('.title')) %>
<div class="flex flex-col w-full my-2">
  <div class="border-2 flex justify-center p-2 bg-gray-300">
    <p class="text-5xl"><%= t('.title') %></p>
  </div>
  <div id="flash">
    <%= render 'shared/flash' %>
  </div>
  <div class="flex flex-col items-center py-2">
    <%= link_to "人物登録",
                new_incident_character_path(@incident),
                data: { turbo_frame: "modal" },
                class: "border-2 rounded-xl h-10 px-4 flex items-center hover:bg-gray-500 active:bg-black active:text-white" %>
  </div>
  <p class="border-b-2 w-full mb-2 text-center"><%= t('.index') %></p>
  <div id="characters-table" class="flex flex-col text-center w-full">
    <%= render @characters %>
  </div>
</div>
